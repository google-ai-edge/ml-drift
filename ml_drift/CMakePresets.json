{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 16,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "host-release",
      "displayName": "Host Release",
      "description": "Host release build",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../build/host-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "host-release-static",
      "displayName": "Host Release (Static)",
      "description": "Host release build (static)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../build/host-release-static",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_SHARED_LIBS": "OFF"
      }
    },
    {
      "name": "android-arm64-debug-static",
      "displayName": "Android ARM64 Debug",
      "description": "64-bit ARM Android device debug build",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../build/android-debug-static",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-24",
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_SHARED_LIBS": "OFF",
        "CMAKE_ANDROID_STL_TYPE": "c++_static"

      },
      "environment": {
        "PATH": "$env{ANDROID_NDK_HOME}/toolchains/llvm/prebuilt/linux-x86_64/bin:$penv{PATH}"
      }
    },
    {
      "name": "android-arm64-release",
      "displayName": "Android ARM64 Release",
      "description": "64-bit ARM Android device release build",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../build/android-release",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-24",
        "CMAKE_BUILD_TYPE": "Release"
      },
      "environment": {
        "PATH": "$env{ANDROID_NDK_HOME}/toolchains/llvm/prebuilt/linux-x86_64/bin:$penv{PATH}"
      }
    },
    {
      "name": "android-arm64-release-static",
      "displayName": "Android ARM64 Release (Static)",
      "description": "64-bit ARM Android device release build (static)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../build/android-release-static",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-24",
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_SHARED_LIBS": "OFF",
        "CMAKE_ANDROID_STL_TYPE": "c++_static"
      },
      "environment": {
        "PATH": "$env{ANDROID_NDK_HOME}/toolchains/llvm/prebuilt/linux-x86_64/bin:$penv{PATH}"
      }
    }
  ]
}

