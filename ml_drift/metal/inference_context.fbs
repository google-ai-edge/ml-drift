include "common/gpu_model.fbs";
include "common/task/serialization_base.fbs";

namespace ml_drift.metal.data;

table MetalProgram {
  define_names:[string];
  define_expressions:[string];
  code:string;
}

table InferenceContext {
  gpu_model:ml_drift.data.GpuModel;
  // Must be serialized after actual Metal objects created
  // Separated from nodes in GpuModel
  tuned_work_group_sizes_per_node:[ml_drift.data.Int3];
  metal_programs:[MetalProgram];
}

root_type InferenceContext;
