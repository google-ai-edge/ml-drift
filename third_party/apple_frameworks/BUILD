# Build rules to inject Apple Frameworks

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "Foundation",
    linkopts = ["-framework Foundation"],
)

cc_library(
    name = "Metal",
    linkopts = ["-framework Metal"],
)

cc_library(
    name = "QuartzCore",
    linkopts = ["-framework QuartzCore"],
)

cc_library(
    name = "XCTest",
    linkopts = ["-framework XCTest"],
)
